{
  "name": "gitnav-workflows",
  "displayName": "GitNav: Visual Git History & Workflows",
  "description": "Explore visual Git history, compare branches and code, and run guarded Git workflows directly in Visual Studio Code.",
  "version": "0.15.0",
  "publisher": "tuna-ex",
  "author": "Tuan Nguyen",
  "icon": "media/icon.png",
  "license": "MIT",
  "galleryBanner": {
    "color": "#24292F",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyentuan0307/DotNav.git",
    "directory": "extensions/gitnav"
  },
  "homepage": "https://github.com/nguyentuan0307/DotNav/tree/master/extensions/gitnav#readme",
  "bugs": {
    "url": "https://github.com/nguyentuan0307/DotNav/issues"
  },
  "keywords": [
    "git",
    "git graph",
    "git history",
    "git log",
    "git workflow",
    "branches",
    "branch management",
    "line history",
    "rebase",
    "cherry-pick",
    "source control"
  ],
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onView:gitnav.gitLog",
    "onCommand:gitnav.showFileHistory",
    "onCommand:gitnav.showHistoryForCurrentLine",
    "onCommand:gitnav.showHistoryForSelection",
    "onCommand:gitnav.compareFileWithBranch",
    "onCommand:gitnav.compareFileWithCommit",
    "onCommand:gitnav.compareSelectionWithBranch",
    "onCommand:gitnav.revealLastChangeInGitLog",
    "onCommand:gitnav.toggleInlineBlame",
    "onCommand:gitnav.showBlameDetails",
    "onCommand:gitnav.openFileAtRevision",
    "onCommand:gitnav.openSettings"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "gitnavPanel",
          "title": "GitNav",
          "icon": "$(git-commit)"
        }
      ]
    },
    "views": {
      "gitnavPanel": [
        {
          "type": "webview",
          "id": "gitnav.gitLog",
          "name": "Git Log"
        }
      ]
    },
    "commands": [
      {
        "command": "gitnav.showFileHistory",
        "title": "Show File History",
        "icon": "$(history)"
      },
      {
        "command": "gitnav.showHistoryForCurrentLine",
        "title": "Show History for Current Line",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitnav.showHistoryForSelection",
        "title": "Show History for Selection",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitnav.compareFileWithBranch",
        "title": "Compare File With Branch...",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitnav.compareFileWithCommit",
        "title": "Compare File With Commit...",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitnav.compareSelectionWithBranch",
        "title": "Compare Selection With Branch...",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitnav.revealLastChangeInGitLog",
        "title": "Reveal Last Change in Git Log",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitnav.toggleInlineBlame",
        "title": "Toggle Inline Blame",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitnav.showBlameDetails",
        "title": "Show Blame Details",
        "icon": "$(info)"
      },
      {
        "command": "gitnav.openFileAtRevision",
        "title": "Open File at Revision...",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitnav.openSettings",
        "title": "GitNav: Open Settings",
        "icon": "$(gear)"
      }
    ],
    "submenus": [
      {
        "id": "gitnav.editorMenu",
        "label": "GitNav"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "gitnav.editorMenu",
          "when": "resourceScheme == file",
          "group": "6_gitnav@1"
        }
      ],
      "gitnav.editorMenu": [
        {
          "command": "gitnav.showFileHistory",
          "group": "1_history@1"
        },
        {
          "command": "gitnav.showHistoryForCurrentLine",
          "group": "1_history@2"
        },
        {
          "command": "gitnav.showHistoryForSelection",
          "when": "editorHasSelection",
          "group": "1_history@3"
        },
        {
          "command": "gitnav.compareFileWithBranch",
          "group": "2_compare@1"
        },
        {
          "command": "gitnav.compareFileWithCommit",
          "group": "2_compare@2"
        },
        {
          "command": "gitnav.compareSelectionWithBranch",
          "when": "editorHasSelection",
          "group": "2_compare@3"
        },
        {
          "command": "gitnav.revealLastChangeInGitLog",
          "group": "3_navigation@1"
        },
        {
          "command": "gitnav.openFileAtRevision",
          "group": "3_navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "gitnav.openSettings",
          "when": "view == gitnav.gitLog",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "GitNav",
      "properties": {
        "gitnav.inlineBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Display inline Git blame annotations at the end of the active editor line. Automatically defaults to false if an external Git blame extension (such as Git Blame or GitLens) is installed."
        },
        "gitnav.inlineBlame.showOnStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Display line blame information in the status bar. Automatically defaults to false if an external Git blame extension is installed."
        },
        "gitnav.inlineBlame.delay": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "description": "Debounce delay in milliseconds before updating inline blame."
        },
        "gitnav.inlineBlame.format": {
          "type": "string",
          "default": "${author}, ${timeAgo} • ${summary}",
          "description": "Format template for inline blame annotations. Placeholders: ${author}, ${timeAgo}, ${date}, ${summary}, ${hash}, ${shortHash}."
        },
        "gitnav.history.maxCommits": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Maximum commits returned by editor history and revision pickers."
        },
        "gitnav.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master",
            "develop",
            "release/*"
          ],
          "description": "Branch name patterns on which history-rewriting Git actions are blocked."
        },
        "gitnav.autoFetch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically fetch repositories while the Git Log view is active."
        },
        "gitnav.autoFetchMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Interval in minutes between automatic fetch operations."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies"
  }
}
